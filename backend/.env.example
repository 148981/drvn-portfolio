# ================================================================
# DRVN 後端環境變數範本
# 複製本檔成 .env 並填入真實值（.env 已被 .gitignore，不進版控）：
#   cp .env.example .env
# production 部署時改用平台的「環境變數 / Secrets」設定，不要把真值放進映像檔。
# ================================================================

# ── 環境 ─────────────────────────────────────────────────────────
# development | production
# production 模式下，機密若仍是預設值，後端會「啟動即報錯」(fail-fast)。
APP_ENV=development

# ── JWT / Session 機密 ───────────────────────────────────────────
# production 必填，且勿用預設值。產生方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_USE_RANDOM_32+_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
SESSION_SECRET=CHANGE_ME_USE_ANOTHER_RANDOM_32+_CHARS

# ── 資料庫（Postgres-ready，預設 SQLite）────────────────────────
# 留空 = 用 SQLite 單檔（backend/data/drvn.db、users.db）。
# 🔴 Railway 等雲端「務必」填 Postgres，否則容器每次重新部署 / 重啟，
#    SQLite 單檔會連同使用者資料一起被清空。
# 上 PostgreSQL 時填入（換這一行即可，程式碼不用改）：
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=
# USERS_DB_URL=

# ── CORS（production 必填：前端正式網域，逗號分隔）──────────────
# 開發/區網留空即可（後端自動允許 localhost + 私網）。
# 例：CORS_ALLOW_ORIGINS=https://app.drvn.com,https://drvn.com
CORS_ALLOW_ORIGINS=

# ── 前端 URL（OAuth callback 跳回這裡）──────────────────────────
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# ── Google OAuth（選填，未填則停用）──────────────────────────────
# 申請：https://console.cloud.google.com → API 和服務 → 憑證 → OAuth 用戶端
# Callback URL: {API_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth（選填）────────────────────────────────────────
# Callback URL: {API_BASE_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── LINE Login（選填）────────────────────────────────────────────
# Callback URL: {API_BASE_URL}/api/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# ── 日誌 ─────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=WARNING

# ── Sign in with Apple（App Store 4.8：有第三方登入就必須有這個）──────────
# 1) Apple Developer → Certificates, Identifiers & Profiles
# 2) Identifiers 建一個 Services ID（例：com.drvn.app.signin），勾 Sign in with Apple
# 3) Configure → Return URLs 填：<API_BASE_URL>/api/auth/apple/callback（必須 https）
# 4) Keys 建一把 Sign in with Apple 金鑰，下載 .p8（只能下載一次）
APPLE_TEAM_ID=
APPLE_SERVICES_ID=
APPLE_KEY_ID=
# .p8 內容（換行寫成 \n），或改用 APPLE_PRIVATE_KEY_PATH 指到檔案
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=
