{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run verify:jsx && npm run verify:tdz && vite build",
    "build:ios": "npm run verify:jsx && npm run verify:tdz && BUILD_TARGET=ios vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify:jsx": "node scripts/verify_jsx_refs.mjs",
    "verify:dupattr": "node scripts/verify_jsx_dup_attrs.mjs",
    "verify:copy": "node scripts/verify_copy_rules.mjs",
    "verify:tdz": "node scripts/verify_component_tdz.mjs",
    "verify:week": "node scripts/verify_preview_hub_week.mjs",
    "verify": "npm run verify:jsx && npm run verify:dupattr && npm run verify:tdz && npm run verify:week && npm run verify:homeweek && npm run verify:wizardweek && npm run verify:handle && npm run verify:baseline && npm run verify:realdata && npm run verify:nodefaults && npm run verify:commit && npm run verify:planstate && npm run verify:under5k && npm run verify:stagedpath && npm run verify:cycle && npm run verify:density && npm run verify:nomock && npm run verify:spelling && npm run verify:pose && npm run verify:recovery && npm run verify:readiness && npm run verify:collections && npm run verify:trainready && npm run verify:hints && npm run verify:copybudget && npm run verify:substitute && npm run verify:logingate && npm run verify:apple && npm run verify:accountdelete && npm run verify:security && npm run verify:boot && npm run verify:science && npm run verify:continuity && npm run verify:membership && npm run verify:quickrun && npm run verify:appstore && npm run verify:gym && npm run verify:runmem && npm run verify:season",
    "verify:membership": "node scripts/verify_membership.mjs",
    "verify:quickrun": "node scripts/verify_quick_run_courses.mjs",
    "verify:appstore": "node scripts/verify_appstore.mjs",
    "verify:gym": "node scripts/verify_gym_memory.mjs",
    "verify:runmem": "node scripts/verify_run_memory.mjs",
    "sync:legal": "node scripts/sync_legal.mjs",
    "verify:handle": "node scripts/verify_drvn_handle.mjs",
    "verify:baseline": "node scripts/verify_cycle_baseline.mjs",
    "verify:realdata": "node scripts/verify_no_fabricated_data.mjs",
    "verify:nodefaults": "node scripts/verify_no_default_biometrics.mjs",
    "verify:commit": "node scripts/verify_cardio_commit.mjs",
    "verify:planstate": "node scripts/verify_run_plan_states.mjs",
    "verify:under5k": "node scripts/verify_under_5k.mjs",
    "verify:stagedpath": "node scripts/verify_staged_path.mjs",
    "verify:cycle": "node scripts/verify_cycle_recommendation.mjs",
    "verify:density": "node scripts/verify_wizard_density.mjs",
    "verify:nomock": "node scripts/verify_backend_no_mock.mjs",
    "verify:spelling": "node scripts/verify_plan_spelling.mjs",
    "verify:pose": "node scripts/verify_pose_analysis.mjs",
    "verify:recovery": "node scripts/verify_recovery.mjs",
    "verify:readiness": "node scripts/verify_readiness.mjs",
    "verify:collections": "node scripts/verify_collections.mjs",
    "verify:trainready": "node scripts/verify_training_readiness.mjs",
    "verify:hints": "node scripts/verify_hints.mjs",
    "verify:copybudget": "node scripts/verify_copy_budget.mjs",
    "verify:homeweek": "node scripts/verify_home_hub_week.mjs",
    "verify:wizardweek": "node scripts/verify_wizard_hub_week.mjs",
    "verify:substitute": "node --import ./scripts/_register_hooks.mjs scripts/verify_substitution.mjs",
    "verify:logingate": "node scripts/verify_login_gate.mjs",
    "verify:apple": "node scripts/verify_apple_signin.mjs",
    "verify:accountdelete": "node scripts/verify_account_delete.mjs",
    "verify:security": "node scripts/verify_security_hardening.mjs",
    "verify:boot": "node scripts/verify_boot_resilience.mjs",
    "verify:science": "node scripts/verify_coach_science.mjs",
    "verify:pysyntax": "node scripts/verify_backend_syntax.mjs",
    "audit:courses": "node ../tools/course-audit/audit_courses.mjs",
    "prelaunch": "npm run verify && npm run verify:pysyntax && npm run audit:courses && npm run check:live",
    "check:config": "python3 ../backend/check_production_config.py",
    "verify:continuity": "node scripts/verify_device_continuity.mjs",
    "check:live": "python3 ../backend/check_production_config.py --remote https://drvn-app-production.up.railway.app",
    "verify:coachplans": "node scripts/verify_coach_plans.mjs",
    "verify:season": "node scripts/verify_season_transition.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@turf/turf": "^7.3.1",
    "axios": "^1.13.2",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.23.26",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "i18next": "^26.3.0",
    "jspdf": "^2.5.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.561.0",
    "matter-js": "^0.20.0",
    "react": "^19.2.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.6",
    "react-i18next": "^17.0.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.6.0",
    "swr": "^2.4.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "terser": "^5.47.1",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
